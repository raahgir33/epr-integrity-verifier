# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e/.scratch/
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
# Per-instance distDirs for the e2e suite's extra `next dev` servers
# (playwright.config.ts). Listed here as well as in the root .gitignore
# because a deploy uses web/ as its source root, and only this file
# applies there.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
