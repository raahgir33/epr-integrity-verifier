# Copy to .env and fill in real values. Never commit .env.

# --- api/ (Vertex AI / Gemini) ---
GCP_PROJECT=your-gcp-project-id
VERTEX_LOCATION=asia-south1
GEMINI_MODEL=gemini-3.5-flash

# --- api/ (BigQuery) ---
BQ_DATASET=epr

# --- api/ (Cloud Storage) ---
DOSSIER_BUCKET=your-project-epr-dossiers
ARTIFACT_BUCKET=your-project-epr-artifacts

# --- api/ (Pub/Sub live event path) ---
PUBSUB_TOPIC=certificate-batches
PUSH_TOKEN=choose-a-long-random-string

# --- web/ (server-side only; do NOT prefix with NEXT_PUBLIC_) ---
API_BASE_URL=http://localhost:8080
