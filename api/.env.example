# EPR Integrity Verifier — environment variables. Copy to api/.env and fill
# in real values; api/.env is git-ignored and never committed.

# --- api/ (Vertex AI / Gemini) ---
GCP_PROJECT=your-gcp-project-id
VERTEX_LOCATION=asia-south1
GEMINI_MODEL=gemini-3.5-flash

# --- api/ (BigQuery) ---
BQ_DATASET=epr

# --- api/ (Cloud Storage) ---
DOSSIER_BUCKET=your-gcp-project-id-epr-dossiers
ARTIFACT_BUCKET=your-gcp-project-id-epr-artifacts

# --- api/ (Pub/Sub live event path, T13) ---
PUBSUB_TOPIC=certificate-batches
# Optional until T13's push endpoint exists (app/config.py's push_token is
# Optional for exactly this reason) — generate with, e.g., `openssl rand -hex 32`.
PUSH_TOKEN=

# --- api/ (served dataset — docs/ARCHITECTURE.md §7) ---
DEFAULT_SEED=42
DEFAULT_FACTS_SOURCE=truth

# --- api/ (agent/extract request timeouts, milliseconds — app/config.py
#     has sane defaults derived from observed latency; override only if
#     you have a specific reason, see that file's comments) ---
# AGENT_HYPOTHESIS_TIMEOUT_MS=120000
# AGENT_CRITIC_TOOLS_TIMEOUT_MS=30000
# AGENT_CRITIC_FINAL_TIMEOUT_MS=30000
# AGENT_REVISION_TIMEOUT_MS=30000
# EXTRACT_REQUEST_TIMEOUT_MS=120000

# --- web/ (server-side only; do NOT prefix with NEXT_PUBLIC_) ---
API_BASE_URL=http://localhost:8080
