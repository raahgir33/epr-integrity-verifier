            "description": "Validation Error"
          }
        },
        "summary": "Get Document Facts"
      }
    },
    "/documents/{doc_id}/file": {
      "get": {
        "description": "doc_id is validated against the documents table for the configured\nseed before any GCS read (docs/BUILD_PLAN.md T11) \u2014 no arbitrary\npaths; the GCS blob path always comes from the row we looked up, never\nfrom the request. Served from an LRU in-memory cache after the first\nrequest for a given doc_id (app/store/cache.py's get_document_file,\nA2) \u2014 Cache-Control below also tells the browser not to ask again.",
        "operationId": "get_document_file_documents__doc_id__file_get",
        "parameters": [
          {
            "in": "path",
            "name": "doc_id",
            "required": true,
            "schema": {
              "title": "Doc Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Document File"
      }
    },
    "/evaluation": {
      "get": {
        "description": "eval_results isn't in app/store/bq.py's SCHEMAS yet (T14 adds it) \u2014\nthis never queries BigQuery at all, so there's no table-not-found\nfailure mode to handle.",
        "operationId": "get_evaluation_evaluation_get",
