        "operationId": "get_processor_memo_processors__processor_id__memo_get",
        "parameters": [
          {
            "in": "path",
            "name": "processor_id",
            "required": true,
            "schema": {
              "title": "Processor Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
