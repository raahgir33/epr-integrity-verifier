            },
            "title": "Observations",
            "type": "array"
          },
          "part_a_paragraph": {
            "title": "Part A Paragraph",
            "type": "string"
          },
          "salutation": {
            "title": "Salutation",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "salutation",
          "part_a_paragraph",
          "closing_paragraph"
        ],
        "title": "VerificationStatement",
        "type": "object"
      }
    }
